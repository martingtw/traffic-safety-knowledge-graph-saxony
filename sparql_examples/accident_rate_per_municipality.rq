PREFIX ex: <http://example.org/traffic/>

SELECT ?name ?population
       (COUNT(?acc) AS ?accidents)
       ((COUNT(?acc) / ?population) * 1000 AS ?accidents_per_1000_inhabitants)
WHERE {
  ?m a ex:Municipality ;
     ex:name ?name ;
     ex:population ?population .

  OPTIONAL {
    ?acc a ex:TrafficAccident ;
         ex:locatedInMunicipality ?m .
  }
}
GROUP BY ?m ?name ?population
ORDER BY DESC(?accidents_per_1000_inhabitants)