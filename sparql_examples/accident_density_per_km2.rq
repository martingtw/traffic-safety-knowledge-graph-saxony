PREFIX ex: <http://example.org/traffic/>

SELECT ?name ?population ?area
       (COUNT(?acc) AS ?accidents)
       ((COUNT(?acc) / ?area) AS ?accidents_per_km2)
WHERE {
  ?m a ex:Municipality ;
     ex:name ?name ;
     ex:population ?population ;
     ex:area_km2 ?area .

  OPTIONAL {
    ?acc a ex:TrafficAccident ;
         ex:locatedInMunicipality ?m .
  }
}
GROUP BY ?m ?name ?population ?area
ORDER BY DESC(?accidents_per_km2)